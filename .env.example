# Load these into your shell; do not commit .env or credentials.
PYTHONIOENCODING=utf-8
REPO_ROOT=.
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=iris-training
AIRFLOW_URL=http://localhost:8080
AIRFLOW_TOKEN=
AIRFLOW_DAG_ID=ml_training
KUBE_NAMESPACE=mlops-agent
KUBE_DEPLOYMENT=iris-api
KUBE_SELECTOR=app=iris-api
AGENT_PLANNER=rules
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
LLAMACPP_URL=http://localhost:11434
TOOL_TIMEOUT_SECONDS=15
LLM_TIMEOUT_SECONDS=120
# Optional subset of local Windows processes; prepared container demo uses llm,agent.
# LOCAL_SERVICES=llm,agent
FRESHNESS_DAYS=30
# Required for HTTP agent access. Generate your own random token.
AGENT_API_TOKEN=
MODEL_PATH=artifacts/model.joblib
MODEL_METADATA_PATH=artifacts/metadata.json
APP_VERSION=1.0.0
